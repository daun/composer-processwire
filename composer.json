{
    "name": "daun/composer-processwire",
    "description": "Install and update ProcessWire with Composer without changing its standard directory layout",
    "type": "composer-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Philipp Daun"
        }
    ],
    "require": {
        "php": "^8.1",
        "composer-plugin-api": "^2.0"
    },
    "require-dev": {
        "composer/composer": "^2.2",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.5 || ^13.4",
        "symfony/process": "^5.4 || ^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Daun\\ComposerProcessWire\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Daun\\ComposerProcessWire\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration"
    },
    "extra": {
        "class": "Daun\\ComposerProcessWire\\Plugin"
    }
}
